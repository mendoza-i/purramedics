# Copy to .env.local for local Vercel dev (never commit real values).
# In production, set these in Vercel Project Settings → Environment Variables.

# Required: Anthropic Claude API key (server-side only — never exposed to browser).
ANTHROPIC_API_KEY=s

# Optional: tighten CORS once you know your deployed domain.
# ALLOWED_ORIGIN=https://your-app.vercel.app
